{
  "name": "midnight-ball-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup:mediapipe": "node scripts/setup-mediapipe.mjs",
    "predev": "node scripts/setup-mediapipe.mjs --if-missing --quiet",
    "dev": "vite",
    "prebuild": "node scripts/setup-mediapipe.mjs --if-missing --quiet",
    "build": "tsc -b && vite build",
