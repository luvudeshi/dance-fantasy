    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "oxlint"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "@vercel/blob": "^2.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
