# Copy to .env at the repo root (never commit .env). The server and Vite both read it.

# ---- Server ----
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ASSETS_DIR=assets
# MAX_UPLOAD_MB=50

# Stage 7 (SerpApi): https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Stage 6 rooms (Tiger Data / Timescale; required on Vercel): postgres://user:pass@host:port/db?sslmode=require
# Leave empty to fall back to SQLite.
DATABASE_URL=

# Optional (MLH Gemini track)
GEMINI_API_KEY=

# ---- Web ----
# Only VITE_* variables reach the browser. Never put secrets in them.
# Empty = same origin (/api is proxied to the server by Vite in dev).
VITE_API_BASE=
