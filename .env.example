# Copy to .env at the repo root (never commit .env). The server and Vite both read it.

# ---- Server ----
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ASSETS_DIR=assets
# MAX_UPLOAD_MB=50

# Stage 7 (SerpApi): https://serpapi.com/manage-api-key
# GET /api/songs/signature needs it plus one LLM key below (404 without).
SERPAPI_API_KEY=

# AI announcer + signature dances (server/app/ai): Meta Muse first, Gemini fallback.
# No key = canned announcer lines. AI_PROVIDER=gemini puts Gemini first.
MUSE_API_KEY=
MUSE_BASE_URL=
MUSE_TEXT_MODEL=
GEMINI_TEXT_MODEL=
AI_PROVIDER=

# Stage 9 (Tiger Data / Timescale): postgres://user:pass@host:port/db?sslmode=require
# Leave empty to fall back to SQLite.
DATABASE_URL=

# Optional (MLH Gemini track): Muse fallback, or primary with AI_PROVIDER=gemini.
# Also the announcer's voice (Gemini TTS, GET /api/announcer/voice/{id}; 503 without a key unless cached).
# Note: a GEMINI_API_KEY exported in your shell wins over this file.
GEMINI_API_KEY=
# A Gemini prebuilt voice for the herald (default in server/app/ai/voice.py).
GEMINI_TTS_VOICE=

# ---- Web ----
# Only VITE_* variables reach the browser. Never put secrets in them.
# Empty = same origin (/api is proxied to the server by Vite in dev).
VITE_API_BASE=
